<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!--
      Two roots: the Avalonia producer (framework sources, XAML build tasks) and
      the rustolonia repository (interop libraries, build configuration). Both
      are relative to this project; explicit MSBuild properties override them.
    -->
    <AvaloniaProducerRoot Condition="'$(AvaloniaProducerRoot)' == ''">$(MSBuildThisFileDirectory)../../../avalonia-src</AvaloniaProducerRoot>
    <RustoloniaRoot Condition="'$(RustoloniaRoot)' == ''">$(MSBuildThisFileDirectory)../../..</RustoloniaRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(AvaloniaProducerRoot)\packages\Avalonia\Avalonia.csproj" />
    <ProjectReference Include="$(RustoloniaRoot)\interop\Avalonia.Rust\Avalonia.Rust.csproj" />
    <ProjectReference Include="$(RustoloniaRoot)\interop\Avalonia.Rust.Interop\Avalonia.Rust.Interop.csproj" />
  </ItemGroup>
  <Import Project="$(RustoloniaRoot)\build\NullableEnable.props" />
  <Import Project="$(RustoloniaRoot)\build\BuildTargets.targets" />
</Project>
