<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(AvsCurrentTargetFramework)</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\interop\Avalonia.Rust.BrowserCom.Generator\Avalonia.Rust.BrowserCom.Generator.csproj" />
    <Reference Include="Microsoft.CodeAnalysis" HintPath="$(MSBuildBinPath)/Roslyn/bincore/Microsoft.CodeAnalysis.dll" />
    <Reference Include="Microsoft.CodeAnalysis.CSharp" HintPath="$(MSBuildBinPath)/Roslyn/bincore/Microsoft.CodeAnalysis.CSharp.dll" />
  </ItemGroup>
  <Target Name="RecordSdkGeneratorPath" BeforeTargets="GetAssemblyAttributes" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute"
                         Condition="'%(Analyzer.Filename)' == 'Microsoft.Interop.ComInterfaceGenerator'">
        <_Parameter1>SdkGeneratorPath</_Parameter1>
        <_Parameter2>%(Analyzer.FullPath)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>
  <Import Project="..\..\build\UnitTests.NetCore.targets" />
  <Import Project="..\..\build\XUnit.props" />
  <PropertyGroup>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>
</Project>
