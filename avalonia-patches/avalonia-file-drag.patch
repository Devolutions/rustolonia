     if (View == NULL)
         return E_FAIL;
 
-    auto nsevent = [NSApp currentEvent];
+    auto nsevent = s_retainedDragEvent != nil ? s_retainedDragEvent : [NSApp currentEvent];
     auto nseventType = [nsevent type];
 
