@@ -9,6 +9,36 @@
 #include "common.h"
 #include "clipboard.h"
 
+static NSEvent* s_retainedDragEvent = nil;
+
+extern "C" __attribute__((visibility("default"))) void* avn_retain_file_drag_event(int windowNumber)
+{
+    auto event = [NSApp currentEvent];
+    if (![NSThread isMainThread] || event == nil || event.windowNumber != windowNumber
+        || event.type != NSEventTypeLeftMouseDown)
+        return nullptr;
+    return (__bridge_retained void*)event;
+}
+
+extern "C" __attribute__((visibility("default"))) int avn_set_file_drag_event(void* event)
+{
+    if (![NSThread isMainThread])
+        return 0;
+    s_retainedDragEvent = (__bridge NSEvent*)event;
+    return 1;
+}
+
+extern "C" __attribute__((visibility("default"))) void avn_release_file_drag_event(void* event)
+{
+    if (event != nullptr)
+        CFRelease(event);
+}
+
+extern "C" __attribute__((visibility("default"))) int avn_supports_retained_file_drag_event()
+{
+    return 1;
+}
+
 TopLevelImpl::~TopLevelImpl() {
     View = nullptr;
 }
