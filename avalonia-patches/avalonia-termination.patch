+using System;
+
+namespace Avalonia.Native;
+
+/// <summary>Optional nonblocking coordination of AppKit termination before window teardown.</summary>
+public static class MacOSTermination
+{
+    /// <summary>Return true to hold AppKit's request until replyToApplicationShouldTerminate:.</summary>
+    public static Func<bool, bool>? DeferRequested { get; set; }
+}
