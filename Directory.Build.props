<Project>

  <!--
    rustolonia repository build configuration.

    Framework versioning, target frameworks, signing and analyzers are vendored
    under build/ so this repository builds standalone. The pinned Avalonia producer
    sits under avalonia-src and keeps its own build configuration; import these
    Rustolonia-owned settings only for projects that are not part of the producer.
  -->

  <PropertyGroup>
    <AvaloniaProducerRoot Condition="'$(AvaloniaProducerRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)avalonia-src'))</AvaloniaProducerRoot>
    <AvsCurrentTargetFramework>net10.0</AvsCurrentTargetFramework>
    <AvsCurrentWindowsTargetFramework>$(AvsCurrentTargetFramework)-windows</AvsCurrentWindowsTargetFramework>
  </PropertyGroup>

  <Import Project="build\AvaloniaPublicKey.props" />
  <Import Project="build\SharedVersion.props" />
  <Import Project="build\NetAnalyzers.props" />

</Project>
